version: sprint_d3_fireball_v1
metadata: {}
entities:
  hero_1:
    type: game_entity
    components:
      attribute_set:
        attributes:
          hp:
            current: 100
            max: 100
          mana:
            current: 20
            max: 20
      tag_set:
        base_tags[1]: unit.hero
        runtime_tags[0]:
      lifecycle:
        alive: true
        death_state: alive
      transform_2d:
        position[2]: 50,100
  enemy_1:
    type: game_entity
    components:
      attribute_set:
        attributes:
          hp:
            current: 50
            max: 50
      tag_set:
        base_tags[1]: unit.enemy
        runtime_tags[0]:
      lifecycle:
        alive: true
        death_state: alive
      transform_2d:
        position[2]: 250,100
effect_defs:
  burn_on_hit:
    type: gameplay_effect_def
    policy:
      duration: 3.0
      tick_rate: 1.0
    modifiers[1]:
      - attribute: hp
        op: add
        value: -2.0
    granted_tags[1]: state.burning
active_effects:
abilities:
  ability_fireball:
    type: ability
    owner: hero_1
    trigger:
      type: on_input
      input_action: cast_fireball
    cost:
      mana: 5
    cooldown: 2.0
    effects[1]:
      - type: spawn_projectile
        projectile_ref: proj_fireball_basic
projectile_defs:
  proj_fireball_basic:
    type: projectile_def
    speed: 400.0
    movement:
      type: linear
      direction[2]: 1.0,0.0
    on_hit:
      apply_effect: burn_on_hit
